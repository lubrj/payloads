            IntPtr hwnd,
            int wMsg,
            int wParam,
            int lParam);

        [DllImport("user32.dll")]
        private static extern bool DestroyWindow(IntPtr hwnd);

        public static Bitmap Capture(int deviceIndex)
        {
            IntPtr handle = capCreateCaptureWindowA(
                "cap",
                0,
                0,
                0,
                1,
                1,
                IntPtr.Zero,
                0);

            if (handle == IntPtr.Zero)
                throw new Exception("Failed to create capture window.");

            if (SendMessage(handle, WM_CAP_DRIVER_CONNECT, deviceIndex, 0) == 0)
